{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "sticklink-golf-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-19",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sticklink-golf",
      "migrations_dir": "../migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROUND_SESSIONS",
        "class_name": "RoundSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoundSession"]
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_ORIGIN": "http://localhost:4321"
  }
}
