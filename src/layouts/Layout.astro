---
import '../styles/global.css';
const {
  title = 'State of Stick Golf',
  description = 'State of Stick Golf connects golfers, courses, and physical touchpoints into a living round passport.',
  eyebrow = 'STATE OF STICK / GOLF',
  image = '/art/flagstick-tap-medallion.png',
  type = 'website',
  robots = 'index, follow',
  structuredData
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://golf.stateofstick.co').toString();
const imageUrl = new URL(image, Astro.site ?? 'https://golf.stateofstick.co').toString();
const siteName = 'State of Stick Golf';
const isPitch = Astro.url.pathname === '/pitch' || Astro.url.pathname === '/pitch/';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#172019" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="Engraved golf flagstick tap medallion beside the green" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: 'https://golf.stateofstick.co/',
      description,
      publisher: { '@type': 'Organization', name: 'State of Stick, Co.', url: 'https://stateofstick.co/' }
    })} />
    {structuredData && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{title}</title>
  </head>
  <body>
    <header class:list={["site-header", "shell", { "site-header-pitch": isPitch }]}>
      <a class="wordmark" href="/" aria-label="State of Stick Golf home"><img src="/brand/golf/sosgolf-logo.png" alt="" /><span>STATE OF STICK <i>/ GOLF</i></span></a>
      {isPitch ? <nav class="pitch-nav" aria-label="Pitch navigation">
        <a href="#how-it-works">The experience</a>
        <a href="#founding-partnership">The partnership</a>
        <a href="/operator/">Operator view</a>
      </nav> : <nav aria-label="Primary navigation">
        <a href="/round/cedar-ridge/">Play a round</a>
        <a href="/passport/">My passport</a>
        <a href="/league/anywhere/">Play anywhere</a>
        <a href="/discover/">Discover</a>
        <details class="more-nav">
          <summary>More</summary>
          <div class="more-nav-menu">
            <a href="/network/">Network</a>
            <a href="/intelligence/">Round intelligence</a>
            <a href="/membership/">Membership</a>
            <a href="/pitch/">For course owners</a>
          </div>
        </details>
      </nav>}
      {isPitch ? <a class="header-cta" href="#founding-partnership">Discuss partnership <span>↗</span></a> : <a class="profile-chip" href="/passport/" aria-label="View Andrea's golfer passport"><span class="avatar">AC</span><span>Andrea</span><span class="chevron">↗</span></a>}
      {!isPitch && <details class="mobile-menu">
        <summary aria-label="Open navigation menu"><span></span><span></span><span></span></summary>
        <nav aria-label="Mobile navigation">
          <a href="/round/cedar-ridge/">Play a round <span>↗</span></a>
          <a href="/passport/">My passport <span>↗</span></a>
          <a href="/league/anywhere/">Play anywhere <span>↗</span></a>
          <a href="/discover/">Discover <span>↗</span></a>
          <a href="/network/">Network <span>↗</span></a>
          <a href="/intelligence/">Round intelligence <span>↗</span></a>
          <a href="/membership/">Membership <span>↗</span></a>
          <a href="/pitch/">For course owners <span>↗</span></a>
        </nav>
      </details>}
    </header>
    <main>
      <div class:list={["shell", "page-eyebrow", { "pitch-page-eyebrow": isPitch }]}>{eyebrow}</div>
      <slot />
    </main>
    <footer class="shell site-footer"><span>PHYSICAL THINGS, LIVING STORIES.</span><span>Proposed first pilot · State of Stick Golf · <a href="https://stateofstick.co/" rel="noopener">State of Stick, Co.</a></span></footer>
  </body>
</html>
