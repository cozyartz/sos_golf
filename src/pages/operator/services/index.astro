---
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Operator Service Fulfillment — State of Stick Golf" description="Review and fulfill connected course service requests with operator audit history." eyebrow="STATE OF STICK GOLF / SERVICE FULFILLMENT">
  <section class="service-page"><div class="service-shell">
    <div class="service-kicker">CONNECTED COURSE OPERATIONS</div><h1>Turn a request<br /><em>into care.</em></h1><p class="service-lead">Keep golfer requests visible to the staff member who can fulfill them. Move each request through an auditable lifecycle while the existing POS remains authoritative for payment and settlement.</p>
    <div class="service-toolbar"><label>COURSE ID<input id="course-id" value="cedar-ridge" /></label><label>STATUS<select id="status-filter"><option value="">All requests</option><option value="requested">Requested</option><option value="accepted">Accepted</option><option value="in_progress">In progress</option><option value="ready">Ready</option><option value="completed">Completed</option><option value="rejected">Rejected</option><option value="cancelled">Cancelled</option></select></label><button class="service-button" id="refresh" type="button">Refresh requests ↗</button></div>
    <div class="service-status" id="status" role="status" aria-live="polite">Connect a verified State of Stick operator session to load private service requests.</div>
    <section class="service-card"><div class="service-card-head"><div><div class="service-kicker">FULFILLMENT QUEUE</div><h2>Today’s requests</h2></div><span id="count">0 requests</span></div><div id="request-list" class="request-list"><div class="request-empty">No private requests loaded.</div></div></section>
  </div></section>
</Layout>

<style>
  .service-page { min-height: calc(100vh - 160px); padding: 58px 0 90px; background: #eef1e6; color: #172019; } .service-shell { width: min(1080px, calc(100% - 44px)); margin: 0 auto; } .service-kicker { color: #a65332; font: 10px 'DM Mono', monospace; letter-spacing: .14em; }
  h1 { max-width: 760px; margin: 14px 0; color: #1d4935; font-size: clamp(48px, 8vw, 92px); line-height: .9; letter-spacing: -.08em; } h1 em { color: #c66e48; font-style: normal; } .service-lead { max-width: 720px; color: #66736a; font-size: 17px; line-height: 1.55; }
  .service-toolbar { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: end; margin: 32px 0 12px; } label { display: grid; gap: 7px; color: #66736a; font: 10px 'DM Mono', monospace; letter-spacing: .08em; } input, select { padding: 12px; border: 1px solid #c7cec2; background: #fffdf7; color: #172019; font: 14px system-ui, sans-serif; } .service-button { padding: 13px 17px; border: 1px solid #1d4935; background: #1d4935; color: #f7f5eb; font: 700 11px 'DM Mono', monospace; cursor: pointer; }
  .service-status { min-height: 24px; margin: 12px 0 22px; color: #a65332; font: 11px 'DM Mono', monospace; } .service-card { padding: 26px; border: 1px solid #cbd1c6; background: #fffdf7; box-shadow: 0 18px 45px #17201910; } .service-card-head { display: flex; justify-content: space-between; gap: 20px; align-items: start; } .service-card h2 { margin: 8px 0; color: #1d4935; font-size: clamp(27px, 4vw, 44px); letter-spacing: -.07em; } .service-card-head > span { color: #66736a; font: 10px 'DM Mono', monospace; }
  .request-list { display: grid; gap: 10px; margin-top: 18px; } .request-row { display: grid; grid-template-columns: 1.2fr .8fr .8fr auto; gap: 14px; align-items: center; padding: 15px; border: 1px solid #d8ddd3; background: #f3f4ec; } .request-row strong { color: #1d4935; } .request-row small { display: block; margin-top: 4px; color: #66736a; font: 10px 'DM Mono', monospace; line-height: 1.4; } .request-row select { padding: 8px; font-size: 12px; } .request-empty { padding: 22px; border: 1px dashed #c7cec2; color: #66736a; font: 11px 'DM Mono', monospace; }
  @media (max-width: 760px) { .service-toolbar { grid-template-columns: 1fr; } .service-card { padding: 20px; } .service-card-head, .request-row { display: grid; grid-template-columns: 1fr; } }
</style>

<script is:inline>
  const apiOrigin = 'https://golf-api.stateofstick.co'; const assertion = () => window.StateOfStick?.identityAssertion ?? document.querySelector('meta[name="state-of-stick-identity"]')?.getAttribute('content') ?? ''; const status = document.querySelector('#status'); const setStatus = (message) => { if (status) status.textContent = message; }; const courseId = () => document.querySelector('#course-id')?.value?.trim() ?? '';
  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
  const request = async (path, options = {}) => { if (!assertion()) throw new Error('Connect a verified State of Stick operator session first.'); const response = await fetch(`${apiOrigin}${path}`, { ...options, headers: { Accept: 'application/json', 'Content-Type': 'application/json', 'x-state-of-stick-identity-assertion': assertion(), ...(options.headers ?? {}) } }); const result = await response.json().catch(() => ({})); if (!response.ok) throw new Error(result?.error?.message ?? 'The service request failed.'); return result; };
  const statuses = ['requested', 'accepted', 'in_progress', 'ready', 'completed', 'rejected', 'cancelled'];
  const render = (requests) => { const list = document.querySelector('#request-list'); const count = document.querySelector('#count'); if (count) count.textContent = `${requests.length} request${requests.length === 1 ? '' : 's'}`; if (!list) return; list.innerHTML = requests.length ? requests.map((item) => `<article class="request-row"><div><strong>${escapeHtml(item.service_name)}</strong><small>${escapeHtml(item.id)} · ${escapeHtml(item.service_type)} · ${escapeHtml(item.fulfillment)}</small></div><div><strong>${escapeHtml(item.quantity)} ×</strong><small>${escapeHtml(item.person_id)}${item.round_id ? ` · ${escapeHtml(item.round_id)}` : ''}</small></div><div><strong>${item.total_cents === null ? 'No price' : `${escapeHtml(item.total_cents)}¢`}</strong><small>${escapeHtml(item.note || 'No golfer note')}</small></div><select data-request-status="${escapeHtml(item.id)}" aria-label="Status for ${escapeHtml(item.id)}">${statuses.map((value) => `<option value="${value}" ${value === item.status ? 'selected' : ''}>${value.replace('_', ' ')}</option>`).join('')}</select></article>`).join('') : '<div class="request-empty">No requests match this filter.</div>'; list.querySelectorAll('[data-request-status]').forEach((select) => select.addEventListener('change', async () => { try { await request(`/api/v1/service-requests/${encodeURIComponent(select.dataset.requestStatus)}/status`, { method: 'POST', body: JSON.stringify({ status: select.value }) }); setStatus('Request status updated and audited.'); await refresh(); } catch (error) { setStatus(error instanceof Error ? error.message : 'Status update failed.'); await refresh(); } })); };
  const refresh = async () => { try { setStatus('Loading private service requests…'); const filter = document.querySelector('#status-filter')?.value ?? ''; const query = filter ? `?status=${encodeURIComponent(filter)}` : ''; const result = await request(`/api/v1/courses/${encodeURIComponent(courseId())}/service-requests${query}`); render(result.requests ?? []); setStatus('Service queue refreshed from Golf D1.'); } catch (error) { setStatus(error instanceof Error ? error.message : 'Unable to load service requests.'); } };
  document.querySelector('#refresh')?.addEventListener('click', refresh);
</script>
