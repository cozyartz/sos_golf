---
import Layout from '../../../layouts/Layout.astro';
---
<style is:global>
  .onboard-page { --o-ink:#142019; --o-green:#1d4935; --o-lime:#c9e56b; --o-copper:#d78355; --o-paper:#f4f1e8; --o-muted:#66736a; background:var(--o-paper); color:#172019; min-height:100vh; }
  .onboard-hero { padding:50px 0 58px; background:radial-gradient(circle at 82% 8%,#315a3f 0,transparent 35%),var(--o-ink); color:#f7f5eb; }
  .onboard-shell { width:min(1100px,calc(100% - 44px)); margin:0 auto; }.onboard-top { display:flex; justify-content:space-between; gap:20px; padding-bottom:20px; border-bottom:1px solid #385244; }.onboard-top strong { font-size:17px; }.onboard-top span,.onboard-kicker { color:var(--o-lime); font:10px 'DM Mono',monospace; letter-spacing:.14em; }
  .onboard-hero h1 { max-width:750px; margin:50px 0 18px; color:#f7f5eb; font-size:clamp(48px,7vw,84px); line-height:.94; letter-spacing:-.08em; }.onboard-hero h1 em { color:var(--o-copper); font-style:normal; }.onboard-hero p { max-width:650px; color:#ced8cf; font-size:18px; line-height:1.55; }.onboard-note { margin-top:22px; max-width:720px; padding:13px 15px; border-left:3px solid var(--o-copper); background:#26372d; color:#d8e2d9; font-size:12px; line-height:1.5; }
  .onboard-main { padding:58px 0 80px; }.onboard-progress { display:grid; grid-template-columns:repeat(5,1fr); gap:6px; margin-bottom:22px; }.onboard-progress button { padding:12px 8px; border:1px solid #d3d0c6; background:#fffdf7; color:var(--o-muted); font:10px 'DM Mono',monospace; cursor:pointer; }.onboard-progress button strong { display:block; margin-bottom:4px; color:var(--o-green); font-size:14px; }.onboard-progress button.active { border-color:var(--o-green); background:var(--o-green); color:#d9e8d5; }.onboard-progress button.active strong { color:var(--o-lime); }
  .onboard-card { padding:30px; border:1px solid #d0cdc3; background:#fffdf7; box-shadow:0 18px 45px #17201912; }.onboard-card[hidden] { display:none; }.onboard-card h2 { margin:9px 0 12px; color:var(--o-green); font-size:clamp(31px,4vw,48px); letter-spacing:-.07em; }.onboard-card > p { max-width:680px; color:var(--o-muted); font-size:15px; line-height:1.55; }
  .onboard-form { display:grid; grid-template-columns:1fr 1fr; gap:13px; margin-top:26px; }.onboard-form label { display:grid; gap:7px; color:var(--o-muted); font:10px 'DM Mono',monospace; letter-spacing:.08em; }.onboard-form input,.onboard-form select { padding:13px; border:1px solid #cbc9bf; background:#f7f5ed; color:#172019; font:14px system-ui,sans-serif; }.onboard-full { grid-column:1/-1; }
  .onboard-options { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:24px; }.onboard-option { display:flex; gap:12px; align-items:flex-start; min-height:130px; padding:17px; border:1px solid #d6d3c9; background:#f7f5ed; cursor:pointer; }.onboard-option:has(input:checked) { border-color:var(--o-green); background:#edf0df; }.onboard-option input { margin-top:3px; accent-color:var(--o-green); }.onboard-option strong,.onboard-option small { display:block; }.onboard-option strong { color:var(--o-green); font-size:16px; }.onboard-option small { margin-top:7px; color:var(--o-muted); font-size:12px; line-height:1.45; }
  .onboard-touchpoints { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:24px; }.onboard-touchpoint { padding:18px; border-top:4px solid var(--o-copper); background:#edf0df; }.onboard-touchpoint strong { display:block; color:var(--o-green); font-size:17px; }.onboard-touchpoint span { display:block; margin-top:7px; color:var(--o-muted); font-size:12px; line-height:1.45; }.onboard-summary { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:26px; }.onboard-summary div { padding:17px; background:#edf0df; }.onboard-summary b { display:block; color:var(--o-green); font-size:28px; letter-spacing:-.06em; }.onboard-summary span { display:block; margin-top:6px; color:var(--o-muted); font:10px 'DM Mono',monospace; line-height:1.4; }
  .onboard-actions { display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; margin-top:28px; }.onboard-button { padding:13px 17px; border:1px solid var(--o-green); background:var(--o-green); color:#f7f5eb; font:700 11px 'DM Mono',monospace; cursor:pointer; }.onboard-button.secondary { background:transparent; color:var(--o-green); }.onboard-status { min-height:18px; margin-top:17px; color:var(--o-copper); font:11px 'DM Mono',monospace; }.onboard-upgrade { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-top:28px; }.onboard-upgrade article { padding:22px; border:1px solid #d1cec4; background:#f7f5ed; }.onboard-upgrade article:last-child { border-top:4px solid var(--o-copper); }.onboard-upgrade h3 { margin:10px 0 8px; color:var(--o-green); font-size:23px; letter-spacing:-.05em; }.onboard-check { display:grid; gap:8px; margin-top:16px; color:var(--o-muted); font-size:13px; }.onboard-check span::before { content:'✓'; margin-right:8px; color:var(--o-green); font-weight:800; }.onboard-footer { margin-top:24px; color:var(--o-muted); font:10px 'DM Mono',monospace; line-height:1.5; }.onboard-footer a { color:var(--o-green); }
  .onboard-growth { padding:30px; background:var(--o-green); color:#f7f5eb; }.onboard-growth h2 { max-width:680px; margin:9px 0 12px; color:#f7f5eb; font-size:clamp(32px,5vw,56px); letter-spacing:-.08em; line-height:.98; }.onboard-growth > p { max-width:700px; color:#d8e3d8; line-height:1.55; }.onboard-growth-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:24px; }.onboard-growth-card { padding:20px; border:1px solid #58705a; background:#244d38; }.onboard-growth-card strong { display:block; color:var(--o-lime); font:10px 'DM Mono',monospace; letter-spacing:.12em; }.onboard-growth-card h3 { margin:9px 0 8px; color:#f7f5eb; font-size:20px; }.onboard-growth-card p,.onboard-growth-card li { color:#d8e3d8; font-size:13px; line-height:1.5; }.onboard-growth-card ul { display:grid; gap:7px; margin:10px 0 0; padding-left:17px; }.onboard-growth-note { margin-top:20px; color:#d8e3d8; font:11px 'DM Mono',monospace; line-height:1.5; }
  @media (max-width:760px) { .onboard-shell { width:min(100% - 36px,1100px); }.onboard-progress { grid-template-columns:1fr 1fr; }.onboard-form,.onboard-options,.onboard-touchpoints,.onboard-upgrade,.onboard-growth-grid { grid-template-columns:1fr; }.onboard-full { grid-column:auto; }.onboard-card,.onboard-growth { padding:21px; }.onboard-summary { grid-template-columns:1fr 1fr; }.onboard-top span { display:none; } }
</style>
<Layout title="Claim Your Course — State of Stick Golf" description="A free-first onboarding path for golf courses to join the State of Stick network and evaluate Connected Course services." eyebrow="STATE OF STICK GOLF / COURSE ONBOARDING">
  <div class="onboard-page"><section class="onboard-hero"><div class="onboard-shell"><div class="onboard-top"><strong>STATE OF STICK / GOLF</strong><span>FREE NETWORK PARTICIPATION · OPERATOR SETUP</span></div><h1>Join the network<br /><em>before you buy.</em></h1><p>Claim a course profile, publish the facts you approve, and give golfers a useful connected experience. Add operator services only when the value is clear.</p><div class="onboard-note"><strong>DEMO SETUP</strong><br />This guided flow shows the proposed onboarding experience. It does not claim that a course has been claimed, approved, connected, or billed.</div></div></section><section class="onboard-growth"><div class="onboard-shell"><div class="onboard-kicker">THE OPERATOR VALUE</div><h2>Your course gets a living search presence—and a record of what golfers do next.</h2><p>When an operator approves a course profile, State of Stick can create a canonical course page built around the facts golfers actually look for. The network then connects that page to discovery, leagues, events, passports, and tap moments.</p><div class="onboard-growth-grid"><article class="onboard-growth-card"><strong>SEARCH-READY COURSE PROFILE</strong><h3>Be findable for the right questions.</h3><p>Approved name, location, scorecard context, local guidance, services, events, and league participation can become clear, crawlable page sections with a stable URL, social preview, structured metadata, and sitemap inclusion.</p><p>That supports discovery; it does not guarantee a ranking or traffic.</p></article><article class="onboard-growth-card"><strong>FIRST-PARTY COURSE ANALYTICS</strong><h3>See interest become action.</h3><ul><li>Course profile views and returning visits</li><li>Tap and QR interactions by location</li><li>Golf Agent questions and unanswered topics</li><li>Service requests, response time, and completion</li><li>Event, league, passport, and round participation</li></ul></article></div><div class="onboard-growth-note">The operator approves what is published. The course receives the value of a maintained digital presence; State of Stick receives the interaction data needed to show what is working. Google Search Console or Business Profile reporting would remain a separate operator-authorized integration.</div></div></section><main class="onboard-main"><div class="onboard-shell"><nav class="onboard-progress" aria-label="Course setup steps"><button class="active" type="button" data-step="1"><strong>01</strong>Claim</button><button type="button" data-step="2"><strong>02</strong>Approve</button><button type="button" data-step="3"><strong>03</strong>Services</button><button type="button" data-step="4"><strong>04</strong>Touchpoints</button><button type="button" data-step="5"><strong>05</strong>Launch</button></nav><section class="onboard-card" data-panel="1"><div class="onboard-kicker" style="color:var(--o-copper)">FREE NETWORK PROFILE</div><h2>Put your course on the map.</h2><p>Start with a public course identity that golfers can find, leagues can invite, and events can reference. No rip-and-replace project.</p><div class="onboard-form"><label>COURSE NAME<input value="Cedar Ridge Golf Club" aria-label="Course name" /></label><label>REGION<select aria-label="Course region"><option>Michigan</option><option>Midwest</option><option>Other</option></select></label><label class="onboard-full">OPERATOR OR COURSE GROUP<input placeholder="Who should receive the setup link?" aria-label="Operator or course group" /></label></div><div class="onboard-actions"><span></span><button class="onboard-button" type="button" data-next="2">Continue to course facts ↗</button></div></section><section class="onboard-card" data-panel="2" hidden><div class="onboard-kicker" style="color:var(--o-copper)">OPERATOR APPROVAL</div><h2>Only publish what you approve.</h2><p>The network can start with course identity, tee sets, holes, location, and league eligibility. Every local fact remains subject to operator review.</p><div class="onboard-options"><label class="onboard-option"><input type="checkbox" checked /><span><strong>Course identity</strong><small>Name, address, region, and public profile.</small></span></label><label class="onboard-option"><input type="checkbox" checked /><span><strong>Scorecard facts</strong><small>Holes, par, tees, rating, slope, and yardage.</small></span></label><label class="onboard-option"><input type="checkbox" /><span><strong>Local guidance</strong><small>Rules, conditions, accessibility, and announcements.</small></span></label></div><div class="onboard-actions"><button class="onboard-button secondary" type="button" data-prev="1">Back</button><button class="onboard-button" type="button" data-next="3">Choose services ↗</button></div></section><section class="onboard-card" data-panel="3" hidden><div class="onboard-kicker" style="color:var(--o-copper)">CONNECTED COURSE SERVICES</div><h2>Start with one useful workflow.</h2><p>Select the moments that matter most to your operation. Services can remain optional, operator-controlled, and separate from your existing POS or tee-sheet system.</p><div class="onboard-options"><label class="onboard-option"><input type="checkbox" checked /><span><strong>Food + drinks</strong><small>Receive approved halfway-house and beverage requests.</small></span></label><label class="onboard-option"><input type="checkbox" checked /><span><strong>Player service</strong><small>Handle water, towels, cart help, rentals, and questions.</small></span></label><label class="onboard-option"><input type="checkbox" /><span><strong>Events + leagues</strong><small>Keep announcements, matches, and participation connected.</small></span></label><label class="onboard-option"><input type="checkbox" checked /><span><strong>Golf Agent</strong><small>Answer from approved course and league context.</small></span></label><label class="onboard-option"><input type="checkbox" /><span><strong>Sponsor moments</strong><small>Offer measurable tournament and partner activations.</small></span></label><label class="onboard-option"><input type="checkbox" /><span><strong>Operator analytics</strong><small>See taps, requests, questions, and activity patterns.</small></span></label></div><div class="onboard-actions"><button class="onboard-button secondary" type="button" data-prev="2">Back</button><button class="onboard-button" type="button" data-next="4">Place touchpoints ↗</button></div></section><section class="onboard-card" data-panel="4" hidden><div class="onboard-kicker" style="color:var(--o-copper)">PHYSICAL-TO-DIGITAL LAYER</div><h2>Make the next action obvious.</h2><p>Start with a few course moments. Use QR as the immediate fallback and StickLink NFC where a durable physical touchpoint makes sense.</p><div class="onboard-touchpoints"><article class="onboard-touchpoint"><strong>01 · First tee</strong><span>Start round, course guidance, local notices, and league check-in.</span></article><article class="onboard-touchpoint"><strong>02 · Hole 07</strong><span>Hole context, challenge, score entry, and Golf Agent question.</span></article><article class="onboard-touchpoint"><strong>03 · Turn house</strong><span>Food, drinks, pickup instructions, and service requests.</span></article></div><div class="onboard-summary"><div><b>3</b><span>Suggested starting points</span></div><div><b>1</b><span>Workflow to prove first</span></div><div><b>0</b><span>System replacements required</span></div></div><div class="onboard-actions"><button class="onboard-button secondary" type="button" data-prev="3">Back</button><button class="onboard-button" type="button" data-next="5">Review launch ↗</button></div></section><section class="onboard-card" data-panel="5" hidden><div class="onboard-kicker" style="color:var(--o-copper)">READY FOR A LOW-RISK PILOT</div><h2>Launch the network layer first.</h2><p>Your course can participate for free, measure interest, and decide later whether Connected Course services are worth paying for.</p><div class="onboard-upgrade"><article><div class="onboard-kicker" style="color:var(--o-green)">NETWORK COURSE · FREE</div><h3>Be discoverable.</h3><div class="onboard-check"><span>Public course profile</span><span>Approved course facts</span><span>League and event participation</span><span>Golfer passport presence</span></div></article><article><div class="onboard-kicker" style="color:var(--o-copper)">CONNECTED COURSE · PAID LAYER</div><h3>Make the property interactive.</h3><div class="onboard-check"><span>Tap and QR touchpoints</span><span>Service requests and Golf Agent</span><span>Operator analytics</span><span>Implementation and support</span></div></article></div><div class="onboard-actions"><button class="onboard-button secondary" type="button" data-prev="4">Back</button><button class="onboard-button" id="finish-onboard" type="button">Create demo setup ↗</button></div><div class="onboard-status" id="onboard-status" role="status" aria-live="polite"></div><div class="onboard-footer">In production, this step would create a review request—not publish a course automatically. <a href="/demo/operator/">See the operator value demo ↗</a></div></section></div></main></div>
</Layout>
<script is:inline>
  const panels = [...document.querySelectorAll('[data-panel]')]; const steps = [...document.querySelectorAll('[data-step]')];
  const show = (number) => { panels.forEach((panel) => { panel.hidden = panel.dataset.panel !== String(number); }); steps.forEach((step) => step.classList.toggle('active', step.dataset.step === String(number))); window.scrollTo({ top: 0, behavior: 'smooth' }); };
  document.querySelectorAll('[data-next]').forEach((button) => button.addEventListener('click', () => show(button.dataset.next)));
  document.querySelectorAll('[data-prev]').forEach((button) => button.addEventListener('click', () => show(button.dataset.prev)));
  steps.forEach((step) => step.addEventListener('click', () => show(step.dataset.step)));
  document.querySelector('#finish-onboard')?.addEventListener('click', () => { const status = document.querySelector('#onboard-status'); if (status) status.textContent = 'Demo setup captured locally. A real launch would send this for operator review and identity verification.'; });
</script>
