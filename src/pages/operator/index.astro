---
import Layout from '../../layouts/Layout.astro';
---
<style is:global>
  .operator-agent { margin-top:26px; padding:30px; border:1px solid #34453c; border-top:4px solid var(--lime); background:#142a20; color:#f7f5eb; }
  .operator-agent-head { display:grid; grid-template-columns:1.05fr .95fr; gap:28px; align-items:start; }
  .operator-agent h2 { margin:10px 0 12px; color:#f7f5eb; font-size:clamp(32px,4vw,52px); letter-spacing:-.06em; }
  .operator-agent h3 { margin:0 0 8px; color:#f7f5eb; font-size:21px; }
  .operator-agent p { color:#b8c8bc; line-height:1.55; }
  .operator-agent-kicker { color:var(--lime); font:10px 'DM Mono',monospace; letter-spacing:.14em; }
  .operator-agent-boundary { padding:18px; border:1px solid #4b6654; background:#1b3b2c; color:#dce7dc; font-size:14px; line-height:1.5; }
  .operator-agent-boundary strong { display:block; margin-bottom:6px; color:var(--lime); font:10px 'DM Mono',monospace; letter-spacing:.12em; }
  .operator-agent-flow { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin:28px 0; }
  .operator-agent-flow span { position:relative; padding:16px 14px; background:#f7f5eb; color:#173b2c; font-size:14px; font-weight:800; line-height:1.3; }
  .operator-agent-flow span:not(:last-child)::after { content:'→'; position:absolute; right:-10px; top:50%; z-index:1; color:var(--lime); font-size:20px; transform:translateY(-50%); }
  .operator-agent-examples { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
  .operator-agent-example { padding:18px; border:1px solid #344f40; background:#102319; }
  .operator-agent-example small { color:var(--lime); font:10px 'DM Mono',monospace; letter-spacing:.1em; }
  .operator-agent-example p { margin:12px 0 0; font-size:14px; }
  .operator-agent-example p strong { color:#f7f5eb; }
  .operator-ai-ops { margin-top:26px; padding-top:24px; border-top:1px solid #344f40; }
  .operator-ai-ops ul { display:grid; grid-template-columns:repeat(2,1fr); gap:8px 24px; margin:16px 0 0; padding:0; list-style:none; }
  .operator-ai-ops li { color:#b8c8bc; font-size:14px; line-height:1.45; }
  .operator-ai-ops li::before { content:'✓'; margin-right:8px; color:var(--lime); font-weight:800; }
  .operator-agent-note { margin:22px 0 0; color:#d9e2d8; font:11px 'DM Mono',monospace; line-height:1.5; }
  .operator-services { margin-top:26px; padding:26px; border:1px solid var(--line); border-top:4px solid var(--orange); background:var(--card); }
  .operator-services-head { display:flex; justify-content:space-between; gap:24px; align-items:end; }
  .operator-services h2 { margin:9px 0 6px; font-size:28px; letter-spacing:-.05em; }
  .operator-services-head p { max-width:420px; margin:0; color:var(--muted); font-size:13px; line-height:1.5; }
  .operator-service-queue { display:grid; gap:8px; margin-top:22px; }
  .operator-service-row { display:grid; grid-template-columns:1fr 130px 110px; gap:16px; align-items:center; padding:15px 0; border-top:1px solid var(--line); }
  .operator-service-row strong,.operator-service-row small { display:block; }.operator-service-row small { margin-top:4px; color:var(--muted); font-size:11px; }.operator-service-status { color:var(--green); font:10px 'DM Mono',monospace; text-transform:uppercase; }.operator-service-time { color:var(--muted); font:10px 'DM Mono',monospace; text-align:right; }
  .operator-services-note { margin-top:18px; color:var(--muted); font:10px 'DM Mono',monospace; line-height:1.5; }
  .operator-service-filters { display:flex; flex-wrap:wrap; gap:7px; margin-top:20px; }
  .operator-service-filter { padding:8px 11px; border:1px solid var(--line); border-radius:4px; background:transparent; color:var(--muted); font:10px 'DM Mono',monospace; cursor:pointer; }
  .operator-service-filter.active,.operator-service-filter:hover { border-color:var(--green); background:var(--green); color:#fffdf8; }
  .operator-service-row.is-hidden { display:none; }
  .operator-service-action { margin-top:7px; padding:0; border:0; background:transparent; color:var(--green); font:10px 'DM Mono',monospace; cursor:pointer; text-decoration:underline; text-underline-offset:3px; }
  .operator-service-action[disabled] { color:var(--muted); cursor:default; text-decoration:none; }
  .operator-service-demo-status { margin-top:12px; color:var(--orange); font:10px 'DM Mono',monospace; }
  .operator-growth { margin-top:26px; padding:28px; border:1px solid #34453c; background:#173326; color:#f7f5eb; }.operator-growth-head { display:flex; justify-content:space-between; gap:24px; align-items:end; }.operator-growth h2 { margin:9px 0 6px; color:#f7f5eb; font-size:clamp(28px,4vw,42px); letter-spacing:-.07em; }.operator-growth-head p { max-width:430px; margin:0; color:#bdcdbf; font-size:13px; line-height:1.5; }.operator-growth-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:22px; }.operator-growth-card { padding:18px; border:1px solid #44604c; background:#10271c; }.operator-growth-card strong { color:var(--lime); font:10px 'DM Mono',monospace; letter-spacing:.1em; }.operator-growth-card h3 { margin:10px 0 7px; color:#f7f5eb; font-size:19px; }.operator-growth-card p { margin:0; color:#bdcdbf; font-size:13px; line-height:1.5; }.operator-growth-note { margin-top:18px; color:#dbe6dc; font:10px 'DM Mono',monospace; line-height:1.5; }
  @media (max-width:800px) { .operator-agent-head { grid-template-columns:1fr; }.operator-agent-flow { grid-template-columns:1fr 1fr; }.operator-agent-flow span:not(:last-child)::after { display:none; }.operator-agent-examples { grid-template-columns:1fr; }.operator-services-head,.operator-growth-head { display:block; }.operator-service-row { grid-template-columns:1fr 100px; }.operator-service-time { text-align:left; }.operator-growth-grid { grid-template-columns:1fr; } }
  @media (max-width:560px) { .operator-agent { padding:22px; }.operator-agent-flow,.operator-ai-ops ul { grid-template-columns:1fr; } }
</style>
<Layout title="Golf Course Engagement Console — StickLink Golf" description="A course operator view for connected golf touchpoints, golfer participation, repeat visits, commerce attribution, and sponsor activations." eyebrow="COURSE CONSOLE / PROPOSED PILOT DATA">
  <section class="page shell"><div class="eyebrow">THE OPERATOR VIEW</div><h1>Make the invisible visible.</h1><p class="page-lead">A calm operating view for the moments that happen across the property—and the revenue, repeat visits, and relationships that follow them.</p><div class="source-note"><strong>DEMONSTRATION CONSOLE</strong><span>The course name, activity counts, touchpoints, and event records shown here are mock product data for illustration. They do not represent a live or approved course partner.<br /><a class="text-link" href="/demo/operator/">Open the connected course demo ↗</a></span></div>
    <div class="dashboard"><div class="panel"><h2>Today's connected activity</h2><div class="stat-grid"><div class="stat"><b>126</b><span>Unique golfers</span></div><div class="stat"><b>418</b><span>Tap events</span></div><div class="stat"><b>34%</b><span>Repeat visitors</span></div></div><div class="activity"><div class="activity-icon">●</div><div><b>Red Tail challenge is live</b><small>42 golfers entered · 9:58 AM</small></div></div><div class="activity"><div class="activity-icon">$</div><div><b>Halfway House orders</b><small>18 orders attributed · $312.40</small></div></div><div class="activity"><div class="activity-icon">✦</div><div><b>Northstar sponsor drop</b><small>63 claims · 21% tap-to-claim</small></div></div></div><div class="panel"><h2>Active touchpoints</h2><div class="activity"><div class="activity-icon">✓</div><div><b>18 tee markers</b><small>Connected and healthy</small></div></div><div class="activity"><div class="activity-icon">✓</div><div><b>04 hospitality points</b><small>Connected and healthy</small></div></div><div class="activity"><div class="activity-icon" style="background:#f1d0b8">!</div><div><b>Cart 031</b><small>Needs attention</small></div></div><a class="button secondary" style="margin-top:20px" href="/course/cedar-ridge/">Preview golfer experience ↗</a></div></div>
    <section class="operator-services"><div class="operator-services-head"><div><div class="operator-agent-kicker" style="color:var(--orange)">SERVICE DESK / PROPOSED PILOT DATA</div><h2>Fulfill the moments that create value.</h2></div><p>Published services can become operator-managed requests. The current view is demonstration data; the API foundation records real catalog items, requests, and status history when connected.</p></div><div class="operator-service-filters" role="group" aria-label="Filter service requests"><button class="operator-service-filter active" type="button" data-filter="all">All requests</button><button class="operator-service-filter" type="button" data-filter="requested">Needs attention</button><button class="operator-service-filter" type="button" data-filter="in_progress">In progress</button><button class="operator-service-filter" type="button" data-filter="completed">Completed</button></div><div class="operator-service-queue"><div class="operator-service-row" data-status="requested"><div><strong>Halfway House order</strong><small>Golfer request · Cart delivery · 2 items</small><button class="operator-service-action" type="button" data-next="accepted">Accept request</button></div><span class="operator-service-status">Requested</span><span class="operator-service-time">2 min ago</span></div><div class="operator-service-row" data-status="in_progress"><div><strong>Cart assistance</strong><small>Player service · Cart 031 · Hole 06</small><button class="operator-service-action" type="button" data-next="ready">Mark ready</button></div><span class="operator-service-status">In progress</span><span class="operator-service-time">8 min ago</span></div><div class="operator-service-row" data-status="completed"><div><strong>Clubhouse question</strong><small>Course information · Local rule request</small><button class="operator-service-action" type="button" disabled>Closed</button></div><span class="operator-service-status">Completed</span><span class="operator-service-time">21 min ago</span></div></div><div class="operator-service-demo-status" id="operator-service-demo-status" role="status" aria-live="polite">Demo mode · filters and status changes stay on this device.</div><div class="operator-services-note">Operator actions are designed around explicit status transitions and audit history. Payment settlement, POS integration, and staff identity remain separate implementation steps.</div></section>
    <section class="operator-agent"><div class="operator-agent-head"><div><div class="operator-agent-kicker">GROUNDED GOLF INTELLIGENCE</div><h2>The Golf Agent</h2><p>The Golf Agent provides grounded answers from approved course, hole, event, league, and player context. It does not invent course information. When the approved record is missing or uncertain, the safe answer is that it does not know.</p></div><div class="operator-agent-boundary"><strong>OPERATOR-CONTROLLED AI GUIDANCE</strong>Operators retain control over published course content, source facts, announcements, approvals, and consequential actions. The current code uses a deterministic rules-engine provider with source facts, confidence, timestamps, rule version, and provenance status.</div></div><div class="operator-agent-flow"><span>Approved course data</span><span>Golf Agent</span><span>Grounded answer</span><span>Optional operator-approved action</span></div><div class="operator-agent-examples"><article class="operator-agent-example"><small>01 / GOLFER · COURSE</small><p><strong>“What should I know about this hole?”</strong><br />Answer from approved hole facts and published course context—or clearly say more information is needed.</p></article><article class="operator-agent-example"><small>02 / GOLFER · EVENT / LEAGUE</small><p><strong>“When is the next event, and where do I stand?”</strong><br />Explain published event or league information while leaving standings authoritative in the record.</p></article><article class="operator-agent-example"><small>03 / OPERATOR · ATTENTION</small><p><strong>“What activity needs my attention?”</strong><br />Summarize recorded rounds, active players, incomplete rounds, tap events, and unapproved geometry for review.</p></article></div><div class="operator-ai-ops"><div class="operator-agent-kicker">AI-ASSISTED OPERATIONS</div><h3>Useful assistance around the console</h3><ul><li>Answer questions from authorized player records.</li><li>Explain published league standings and tie policy.</li><li>Summarize course activity and incomplete records.</li><li>Surface tap activity and unapproved geometry for review.</li><li>Keep source facts, confidence, and advisory status visible.</li><li>Record feedback on whether an insight was useful or incorrect.</li></ul></div><div class="operator-agent-note">HUMAN APPROVAL REMAINS IN CONTROL · The agent can explain and surface; it does not publish course content, change official scores, decide rules, move money, or take consequential action by itself.</div></section>
    <section class="operator-growth"><div class="operator-growth-head"><div><div class="operator-agent-kicker">PUBLIC PROFILE / PROPOSED PILOT DATA</div><h2>Turn course approval into a living presence.</h2></div><p>When an operator publishes approved facts, the course can become discoverable through a stable profile connected to leagues, events, services, and golfer activity.</p></div><div class="operator-growth-grid"><article class="operator-growth-card"><strong>01 / SEARCH PRESENCE</strong><h3>Be findable for useful questions.</h3><p>Approved course identity, scorecard context, local guidance, events, and services can power a clear public profile with canonical metadata and structured content.</p></article><article class="operator-growth-card"><strong>02 / FIRST-PARTY SIGNALS</strong><h3>See what golfers do next.</h3><p>Measure profile visits, tap interactions, Golf Agent questions, service requests, league participation, and repeat activity in one operator view.</p></article><article class="operator-growth-card"><strong>03 / CONTROLLED PUBLISHING</strong><h3>Keep the course record yours.</h3><p>Nothing becomes public just because it is entered. Operators approve, publish, update, or unpublish the course profile and local content.</p></article></div><div class="operator-growth-note">DEMONSTRATION DATA · Search visibility and traffic are not guaranteed. Public publishing requires operator approval and production identity verification.</div></section><div class="operator-tools"><article><span>01 · COURSE PROFILE</span><h2>Edit the course record.</h2><p>Review address, operator-seeded coordinates, holes, tees, and data sources before publication.</p></article><article><span>02 · MAP APPROVAL</span><h2>Approve geometry.</h2><p>Every boundary, hole, hazard, green, tee, and StickLink location keeps an operator approval event.</p></article><article><span>03 · SCORE REVIEW</span><h2>Verify with evidence.</h2><p>Tap events, witness confirmation, round audit history, and rejection reasons stay attached to the round.</p></article><article><span>04 · LEAGUES + ANNOUNCEMENTS</span><h2>Keep the network alive.</h2><p>Create public or private leagues, publish results, and share course updates without touching money.</p></article></div><div class="source-note"><strong>OPERATOR SAFETY</strong><span>All writes require the existing service-auth seam plus organization and actor headers. This pilot does not infer membership from a client-supplied organization id; production identity integration remains a State of Stick boundary.<br /><a class="text-link" href="/operator/onboard/">Start the free course setup ↗</a></span></div>
  </section>
  <script>
    const serviceRows = [...document.querySelectorAll('.operator-service-row')]; const serviceFilters = [...document.querySelectorAll('.operator-service-filter')]; const serviceDemoStatus = document.querySelector('#operator-service-demo-status');
    serviceFilters.forEach((filter) => filter.addEventListener('click', () => { const selected = filter.getAttribute('data-filter') ?? 'all'; serviceFilters.forEach((item) => item.classList.toggle('active', item === filter)); serviceRows.forEach((row) => row.classList.toggle('is-hidden', selected !== 'all' && row.getAttribute('data-status') !== selected)); }));
    document.querySelectorAll('.operator-service-action:not([disabled])').forEach((action) => action.addEventListener('click', () => { const row = action.closest('.operator-service-row'); const status = row?.querySelector('.operator-service-status'); const next = action.getAttribute('data-next'); if (!row || !status || !next) return; const label = next === 'ready' ? 'Ready' : 'Accepted'; status.textContent = label; row.setAttribute('data-status', next); action.textContent = 'Demo update applied'; action.setAttribute('disabled', 'true'); if (serviceDemoStatus) serviceDemoStatus.textContent = `Demo update: request marked ${label.toLowerCase()}. Production status changes require operator authentication.`; }));
  </script>
</Layout>
