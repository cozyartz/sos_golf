---
import Layout from '../../../layouts/Layout.astro';
const players = [{ name: 'Andrea Cozart-Lundin', club: 'Cedar Ridge', score: 36, holes: 9, status: 'LIVE' }, { name: 'Marcus Bell', club: 'Bedford Valley', score: 38, holes: 9, status: 'LIVE' }, { name: 'Tina Alvarez', club: 'Arcadia Bluffs', score: 39, holes: 9, status: 'LIVE' }, { name: 'James Porter', club: 'Briar Hill', score: 40, holes: 9, status: 'LIVE' }];
---
<Layout title="Golf Tournament Identity — StickLink Golf" description="A connected golf tournament concept for players, teams, sponsors, challenges, results, and physical event memories." eyebrow="EVENT ID / 2027 STATE OF STICK INVITATIONAL">
  <section class="page shell"><div class="event-hero"><div><div class="eyebrow">LIVE EVENT · BEDFORD VALLEY · MICHIGAN</div><h1>State of Stick<br /><em>Invitational.</em></h1><p>One event identity for players, teams, sponsors, challenges, results, and the physical memories that remain.</p></div><div class="event-token"><span>EVENT ID</span><b>SSI-2027-001</b><small>● LIVE / 144 PLAYERS</small></div></div><div class="event-grid"><div class="panel"><div class="score-panel-head"><h2>Live leaderboard</h2><span class="live-pill">● UPDATED NOW</span></div><div class="leaderboard">{players.map((player, index) => <div class="leader-row"><b class="rank">{String(index + 1).padStart(2, '0')}</b><div><strong>{player.name}</strong><small>{player.club} · {player.holes} holes</small></div><b class="event-score">{player.score}</b><span class="event-status">{player.status}</span></div>)}</div></div><div class="panel"><div class="eyebrow">EVENT GRAPH</div><h2>Everything has an identity.</h2><div class="event-facts"><span><b>144</b> players</span><span><b>36</b> teams</span><span><b>12</b> sponsors</span><span><b>42</b> StickLinks</span><span><b>18</b> challenges</span><span><b>03</b> collectibles</span></div><a class="button" href="/network/">View network ↗</a></div></div><div class="event-bottom"><article><span>PLAYER ARRIVAL</span><h3>Tap your Golf Passport.</h3><p>Identity joins the event before the first shot.</p></article><article><span>PHYSICAL PROOF</span><h3>Make accomplishments permanent.</h3><p>Results, witnesses, and collectibles stay connected.</p></article><article><span>SPONSOR VALUE</span><h3>Measure what actually happened.</h3><p>Interactions, claims, challenges, and return signals.</p></article></div></section>
</Layout>
