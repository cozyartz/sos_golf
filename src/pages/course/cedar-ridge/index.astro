---
import Layout from '../../../layouts/Layout.astro';
import { cedarRidge, startingScores } from '../../../lib/golf';
import { courseDescription, courseStructuredData, courseTitle } from '../../../lib/seo';
---
<Layout title={courseTitle(cedarRidge)} description={courseDescription(cedarRidge)} eyebrow="COURSE PASSPORT / CEDAR RIDGE GOLF CLUB" structuredData={courseStructuredData(cedarRidge)}>
  <section class="page shell">
    <div class="course-hero"><div><div class="eyebrow">MAPLE CITY, MICHIGAN · MEMBER GUEST</div><h1>Cedar Ridge</h1><p>18 holes · 6,421 yards · Playing with the Cozart group</p></div><div class="course-meta">PLAYED HERE ✓<br />HOLE 06 OF 18<br /><span style="color:var(--lime)">● ROUND IN PROGRESS</span></div></div>
    <div class="course-network-grid" style="margin-top:28px"><article class="course-network-card"><span>COURSE PASSPORT</span><h3>Every round counts.</h3><p>Your verified moments, league entries, and course history travel with you.</p><a class="button secondary" href="/passport/">Open passport ↗</a></article><article class="course-network-card"><span>ACTIVE COMPETITION</span><h3>Great Lakes Open</h3><p>Stableford · 86 golfers · 214 rounds completed.</p><a class="button secondary" href="/league/anywhere/">View standings ↗</a></article><article class="course-network-card"><span>OPERATOR NOTE</span><h3>Welcome to Cedar Ridge.</h3><p>Hole 09 turn-house ordering is open. Tap points are course-owned.</p><span class="data-source">Source: operator announcement</span></article><article class="course-network-card"><span>ROUND STATUS</span><h3 id="offline-status">Ready to score</h3><p>Score entry is saved on this device when you lose service.</p><button class="button secondary" id="location-button" type="button">Enable location</button></article></div>
    <section class="course-services" aria-labelledby="course-services-title"><div class="section-head"><div><div class="eyebrow">TAP-CONNECTED SERVICES</div><h2 id="course-services-title">Get what you need<br />without leaving the round.</h2></div><p class="section-intro">A course can publish approved services at the moments golfers need them. This is a local pilot demonstration; production requests require golfer identity and operator fulfillment.</p></div><div class="course-service-grid"><article class="course-service-card"><span>01 / TURN HOUSE</span><h3>Food and drinks</h3><p>Order from the approved halfway-house menu for pickup or cart delivery.</p><button type="button" data-service="Food and drinks" class="button service-request-button">Request service</button></article><article class="course-service-card"><span>02 / CLUBHOUSE</span><h3>Player assistance</h3><p>Ask for water, towels, rental help, cart support, or a clubhouse answer.</p><button type="button" data-service="Player assistance" class="button service-request-button">Request service</button></article><article class="course-service-card"><span>03 / GOLF AGENT</span><h3>Course guidance</h3><p>Ask questions using approved course and hole context, with human approval remaining in control.</p><a class="button secondary" href="/operator/">See operator controls ↗</a></article></div><div class="course-service-status" id="service-request-status" role="status" aria-live="polite">Demo mode · select a service to see the request flow.</div></section>
    <div class="course-score-card"><div><div class="eyebrow">OFFLINE SCORE ENTRY</div><h2>Keep the round moving.</h2><p>Hole 06 · The Crossing · Par 3 · 142 yards</p></div><div class="course-score-controls"><button type="button" id="score-minus" aria-label="Decrease hole 6 score">−</button><strong id="course-hole-score">{startingScores.find((score) => score.hole === 6)?.strokes || 0}</strong><button type="button" id="score-plus" aria-label="Increase hole 6 score">+</button><button class="button" type="button" id="save-score">Save on device</button></div><small id="score-save-status">Not yet synced · no secret is stored in browser storage</small></div>
    <div class="section-head" style="margin-top:54px"><div><div class="eyebrow">FREE-FIRST COURSE MAP</div><h2>A living network, even without imagery.</h2></div><p class="section-intro">This diagram is the safe fallback for every course. Official score, yardage, and league data remain authoritative elsewhere.</p></div>
    <div class="course-map-card"><div class="course-map" id="course-map" aria-label="Cedar Ridge course diagram"><svg viewBox="0 0 800 420" role="img" aria-label="Cedar Ridge course diagram"><rect x="8" y="8" width="784" height="404" rx="24" fill="#dfe8c0" />{Array.from({ length: 18 }, (_, index) => { const x = 70 + (index % 6) * 125; const y = index < 6 ? 105 : index < 12 ? 220 : 335; return <g><path d={`M ${x} ${y} C ${x + 36} ${y - 22}, ${x + 75} ${y + 22}, ${x + 100} ${y}`} fill="none" stroke="#7e9d5d" stroke-width="25" stroke-linecap="round" /><text x={x} y={y - 28} fill="#172019" font-size="14">{String(index + 1).padStart(2, '0')}</text>{index % 3 === 0 && <circle cx={x + 92} cy={y} r="5" fill="#e98745" />}</g>})}</svg></div><div class="map-legend"><span><i class="legend-dot fairway"></i> hole geometry</span><span><i class="legend-dot tap-point"></i> StickLink tap point</span><span><i class="legend-dot green-point"></i> green / tee context</span><small id="imagery-label">Imagery unavailable — course diagram shown</small></div></div>
    <div class="section-head" style="margin-top:54px"><div><div class="eyebrow">HOLE-BY-HOLE NAVIGATION</div><h2>Find your next moment.</h2></div><p class="section-intro">Tap a hole to jump into scoring, local notes, and the league context for this round.</p></div>
    <div class="hole-list">{cedarRidge.holes.map((hole) => <a class="hole-row" href={`/round/cedar-ridge/#hole-${hole.number}`}><div class="hole-no">{String(hole.number).padStart(2, '0')}</div><div><h3>{hole.name}</h3><p>Par {hole.par} · {hole.yards} yards{hole.challenge ? ` · ${hole.challenge}` : ''}</p></div>{hole.challenge && <span class="hole-tag">{hole.challenge.toUpperCase()}</span>}<span class="tap">OPEN ↗</span></a>)}</div>
    <div class="source-note"><strong>DATA SOURCE</strong><span>Course facts and league status are supplied by the pilot dataset. Map geometry and tap points require operator approval. No player trail is shown by default. If imagery is added, this page will say “imagery captured on [date]”; it will never imply live satellite coverage.</span></div>
  </section>
  <script>
    import { savePendingRound } from '../../../lib/offline-round';
    const status = document.querySelector('#offline-status');
    const locationButton = document.querySelector('#location-button');
    const setStatus = () => { if (status) status.textContent = navigator.onLine ? 'Ready to score' : 'Offline · saved on device'; };
    window.addEventListener('online', setStatus); window.addEventListener('offline', setStatus); setStatus();
    locationButton?.addEventListener('click', () => { if (!navigator.geolocation) { locationButton.textContent = 'Location unavailable'; return; } navigator.geolocation.getCurrentPosition(() => { locationButton.textContent = 'Location enabled'; }, () => { locationButton.textContent = 'Location not shared'; }, { enableHighAccuracy: false, maximumAge: 60000 }); });
    let holeSixScore = Number(document.querySelector('#course-hole-score')?.textContent ?? 0);
    const scoreDisplay = document.querySelector('#course-hole-score');
    const scoreStatus = document.querySelector('#score-save-status');
    document.querySelector('#score-minus')?.addEventListener('click', () => { holeSixScore = Math.max(0, holeSixScore - 1); if (scoreDisplay) scoreDisplay.textContent = String(holeSixScore); });
    document.querySelector('#score-plus')?.addEventListener('click', () => { holeSixScore = Math.min(12, holeSixScore + 1); if (scoreDisplay) scoreDisplay.textContent = String(holeSixScore); });
    document.querySelector('#save-score')?.addEventListener('click', async () => { const scores = [{ hole: 6, strokes: holeSixScore, tapVerified: true, witnessConfirmed: false }]; await savePendingRound({ id: 'round-cedar-ridge-081926', courseId: 'cedar-ridge', personId: 'sg-00a79234', scores, attempts: 0, updatedAt: new Date().toISOString() }); if (scoreStatus) scoreStatus.textContent = navigator.onLine ? 'Saved on device · ready to sync' : 'Saved offline · will retry when connected'; });
    const serviceStatus = document.querySelector('#service-request-status'); document.querySelectorAll('.service-request-button').forEach((button) => button.addEventListener('click', () => { const service = button.getAttribute('data-service') ?? 'Service'; if (serviceStatus) serviceStatus.textContent = `Demo request captured for ${service}. In a connected pilot, this would be sent to the course operator for fulfillment.`; }));
  </script>
</Layout>
