---
import Layout from '../../../../layouts/Layout.astro';
---
<Layout title="Cedar Ridge Services — State of Stick Golf" description="Request an approved Cedar Ridge course service from the connected golfer experience." eyebrow="CEDAR RIDGE / CONNECTED SERVICE REQUEST">
  <section class="request-page"><div class="request-shell"><div class="request-kicker">CONNECTED GOLFER SERVICE</div><h1>Make the turn<br /><em>easier.</em></h1><p class="request-lead">Choose an approved Cedar Ridge service, tell the course where to fulfill it, and send the request to the operator queue. Payment settlement remains with the course’s POS.</p><div class="request-status" id="status" role="status" aria-live="polite">Loading approved course services…</div><div id="service-list" class="service-list"><div class="service-empty">Loading services.</div></div><div class="request-note">A verified State of Stick golfer session is required to submit a request. No payment is collected by this pilot page.</div></div></section>
</Layout>

<style>
  .request-page { min-height: calc(100vh - 160px); padding: 58px 0 90px; background: #eef1e6; color: #172019; } .request-shell { width: min(940px, calc(100% - 44px)); margin: 0 auto; } .request-kicker { color: #a65332; font: 10px 'DM Mono', monospace; letter-spacing: .14em; } h1 { margin: 14px 0; color: #1d4935; font-size: clamp(48px, 8vw, 92px); line-height: .9; letter-spacing: -.08em; } h1 em { color: #c66e48; font-style: normal; } .request-lead { max-width: 720px; color: #66736a; font-size: 17px; line-height: 1.55; } .request-status { min-height: 24px; margin: 28px 0 18px; color: #a65332; font: 11px 'DM Mono', monospace; }
  .service-list { display: grid; gap: 12px; } .service-card { padding: 23px; border: 1px solid #cbd1c6; background: #fffdf7; box-shadow: 0 18px 45px #17201910; } .service-card h2 { margin: 8px 0; color: #1d4935; font-size: 30px; letter-spacing: -.06em; } .service-card p { max-width: 680px; color: #66736a; line-height: 1.5; } .service-meta { color: #66736a; font: 10px 'DM Mono', monospace; } .service-form { display: grid; grid-template-columns: 1fr 1fr 1.4fr auto; gap: 10px; align-items: end; margin-top: 20px; } label { display: grid; gap: 7px; color: #66736a; font: 10px 'DM Mono', monospace; letter-spacing: .08em; } input, select { padding: 11px; border: 1px solid #c7cec2; background: #f7f5ed; color: #172019; font: 14px system-ui, sans-serif; } .request-button { padding: 12px 14px; border: 1px solid #1d4935; background: #1d4935; color: #f7f5eb; font: 700 10px 'DM Mono', monospace; cursor: pointer; } .request-button:disabled { cursor: wait; opacity: .55; } .service-empty { padding: 22px; border: 1px dashed #c7cec2; color: #66736a; font: 11px 'DM Mono', monospace; } .request-note { margin-top: 20px; padding: 14px; border-left: 3px solid #c66e48; background: #f3f4ec; color: #66736a; font: 11px 'DM Mono', monospace; line-height: 1.5; }
  @media (max-width: 760px) { .service-form { grid-template-columns: 1fr; } .service-card { padding: 20px; } }
</style>

<script is:inline>
  const apiOrigin = 'https://golf-api.stateofstick.co'; const assertion = () => window.StateOfStick?.identityAssertion ?? document.querySelector('meta[name="state-of-stick-identity"]')?.getAttribute('content') ?? ''; const status = document.querySelector('#status'); const setStatus = (message) => { if (status) status.textContent = message; }; const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character]);
  const request = async (path, options = {}) => { const response = await fetch(`${apiOrigin}${path}`, { ...options, headers: { Accept: 'application/json', 'Content-Type': 'application/json', ...(assertion() ? { 'x-state-of-stick-identity-assertion': assertion() } : {}), ...(options.headers ?? {}) } }); const result = await response.json().catch(() => ({})); if (!response.ok) throw new Error(result?.error?.message ?? 'The service request failed.'); return result; };
  const render = (services) => { const list = document.querySelector('#service-list'); if (!list) return; list.innerHTML = services.length ? services.map((service) => { let modes = []; try { modes = JSON.parse(service.fulfillment_modes); } catch { modes = ['clubhouse']; } return `<article class="service-card"><div class="request-kicker">${escapeHtml(service.service_type)}</div><h2>${escapeHtml(service.name)}</h2><p>${escapeHtml(service.description)}</p><div class="service-meta">${service.price_cents === null ? 'Operator-priced at fulfillment' : `${escapeHtml(service.price_cents)}¢`} · ${escapeHtml(modes.join(' · '))}</div><div class="service-form"><label>QUANTITY<input data-quantity="${escapeHtml(service.id)}" type="number" min="1" max="20" value="1" /></label><label>FULFILLMENT<select data-fulfillment="${escapeHtml(service.id)}">${modes.map((mode) => `<option value="${escapeHtml(mode)}">${escapeHtml(mode.replace('_', ' '))}</option>`).join('')}</select></label><label>NOTE<input data-note="${escapeHtml(service.id)}" maxlength="500" placeholder="Cart, hole, or helpful context" /></label><button class="request-button" data-request="${escapeHtml(service.id)}" type="button">Send request ↗</button></div></article>`; }).join('') : '<div class="service-empty">No published services are available for this course.</div>'; list.querySelectorAll('[data-request]').forEach((button) => button.addEventListener('click', () => submit(button.dataset.request))); };
  const submit = async (serviceId) => { const quantity = Number(document.querySelector(`[data-quantity="${CSS.escape(serviceId)}"]`)?.value ?? 1); const fulfillment = document.querySelector(`[data-fulfillment="${CSS.escape(serviceId)}"]`)?.value ?? 'clubhouse'; const note = document.querySelector(`[data-note="${CSS.escape(serviceId)}"]`)?.value ?? ''; if (!assertion()) { setStatus('Connect a verified State of Stick golfer session before sending a request.'); return; } try { setStatus('Sending request to the course operator…'); const result = await request('/api/v1/courses/cedar-ridge/service-requests', { method: 'POST', body: JSON.stringify({ serviceId, quantity, fulfillment, note, roundId: localStorage.getItem('sosgolf:cedar-ridge:round-id') || undefined }) }); setStatus(`Request ${result.request?.id ?? 'created'} sent to Cedar Ridge. The operator will update its fulfillment status.`); } catch (error) { setStatus(error instanceof Error ? error.message : 'Unable to send the request.'); } };
  request('/api/v1/courses/cedar-ridge/services').then((result) => { render(result.services ?? []); setStatus('Published services loaded.'); }).catch((error) => setStatus(error instanceof Error ? error.message : 'Unable to load services.'));
</script>
