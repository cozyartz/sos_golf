---
import Layout from '../../layouts/Layout.astro';
import { golferPlans, planHasFeature, type GolferFeature } from '../../lib/membership';

const comparison: Array<{ label: string; feature: GolferFeature }> = [
  { label: 'Save rounds and build a passport', feature: 'saved_rounds' },
  { label: 'Ask the Golf Agent', feature: 'basic_golf_agent' },
  { label: 'Cross-course matches', feature: 'cross_course_matches' },
  { label: 'Private leagues', feature: 'private_leagues' },
  { label: 'Advanced round insights', feature: 'advanced_round_insights' },
  { label: 'Practice suggestions', feature: 'practice_suggestions' },
  { label: 'Season analytics', feature: 'season_analytics' },
  { label: 'Custom challenges', feature: 'custom_challenges' },
  { label: 'Commissioner tools', feature: 'commissioner_tools' }
];
---
<Layout title="Golfer Membership — State of Stick Golf" description="Choose how deeply you want to participate in the State of Stick Golf network, from free membership to advanced player intelligence." eyebrow="GOLFER MEMBERSHIP / STATE OF STICK GOLF">
  <section class="page shell membership-page">
    <div class="eyebrow">PLAY FREE · GO DEEPER WHEN IT MATTERS</div>
    <h1>Your game should<br /><em>travel with you.</em></h1>
    <p class="page-lead">Basic play stays open. Membership adds the identity, history, intelligence, and competition that make every course part of one connected season.</p>
    <div class="source-note"><strong>PROPOSED MEMBERSHIP MODEL</strong><span>These levels describe the product design under consideration. Prices, billing terms, and live entitlements are not finalized or active.</span></div>
    <div class="membership-grid">
      {golferPlans.map((plan) => <article class:list={["membership-card", { "membership-card-featured": plan.key === 'player_plus' }]}>
        <div class="eyebrow">{plan.key.replaceAll('_', ' ').toUpperCase()}</div>
        <h2>{plan.name}</h2>
        <div class="membership-price">{plan.priceDisplay}</div>
        <small>{plan.billingDisplay}</small>
        <p>{plan.description}</p>
        <strong class="membership-audience">{plan.audience}</strong>
        <div class="membership-ai"><span>GOLF AGENT ALLOWANCE</span><b>{plan.aiQuestionsPerMonth === null ? 'Usage-based' : `${plan.aiQuestionsPerMonth} questions`}</b><small>per month · subject to final policy</small></div>
        <ul>{comparison.filter((item) => planHasFeature(plan, item.feature)).slice(0, 7).map((item) => <li>{item.label}</li>)}</ul>
        <button class="button secondary" type="button" disabled>{plan.proposed ? 'Coming after pilot' : 'Join when membership opens'}</button>
      </article>)}
    </div>
    <section class="membership-sponsor"><div><div class="eyebrow">THE BUSINESS MODEL</div><h2>Let the course create the habit.</h2><p>Connected Course operators pay for operational value. They can sponsor basic Golf Agent access for golfers, while paid membership is reserved for deeper personal intelligence, advanced competition, and season-long value.</p></div><div class="membership-sponsor-flow"><span>Course revenue</span><i>→</i><span>Useful free play</span><i>→</i><span>Paid depth</span></div></section>
    <section class="membership-ai-note"><div class="eyebrow">HOW THE AGENT STAYS TRUSTWORTHY</div><h2>Paid access adds depth—not authority.</h2><p>Every level receives answers bounded by approved course, round, league, and player context. A subscription can unlock more analysis or usage, but it never lets AI decide official scores, handicaps, standings, payments, or course rules.</p><a class="text-link" href="/operator/">See the operator-controlled AI model ↗</a></section>
  </section>
</Layout>
<style>
  .membership-page h1 em { color:var(--orange); font-style:normal; }.membership-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:10px; margin-top:30px; }.membership-card { display:flex; flex-direction:column; padding:22px; border:1px solid var(--line); background:var(--card); }.membership-card-featured { border-top:4px solid var(--orange); background:#fff9ef; }.membership-card h2 { margin:12px 0 2px; color:var(--green); font-size:27px; letter-spacing:-.06em; }.membership-price { margin-top:16px; color:var(--green); font-size:25px; font-weight:800; letter-spacing:-.06em; }.membership-card > small { color:var(--muted); font:10px 'DM Mono',monospace; }.membership-card p { min-height:75px; color:var(--muted); font-size:13px; line-height:1.5; }.membership-audience { min-height:48px; color:var(--ink); font-size:12px; line-height:1.4; }.membership-ai { display:grid; gap:4px; margin:18px 0; padding:13px; background:#edf0df; }.membership-ai span,.membership-ai small { color:var(--muted); font:9px 'DM Mono',monospace; }.membership-ai b { color:var(--green); font-size:15px; }.membership-card ul { display:grid; gap:7px; min-height:155px; margin:0 0 20px; padding:0; list-style:none; color:var(--ink); font-size:12px; line-height:1.35; }.membership-card li::before { content:'✓'; margin-right:7px; color:var(--green); font-weight:800; }.membership-card button { margin-top:auto; opacity:.7; cursor:not-allowed; }.membership-sponsor { display:grid; grid-template-columns:1fr 1fr; gap:28px; align-items:center; margin-top:54px; padding:30px; background:var(--green); color:#f7f5eb; }.membership-sponsor h2,.membership-ai-note h2 { margin:9px 0 10px; color:inherit; font-size:clamp(30px,4vw,48px); letter-spacing:-.07em; }.membership-sponsor p,.membership-ai-note p { max-width:600px; color:#cad9cb; line-height:1.55; }.membership-sponsor-flow { display:grid; grid-template-columns:1fr auto 1fr auto 1fr; gap:8px; align-items:center; }.membership-sponsor-flow span { padding:15px 10px; background:#f7f5eb; color:var(--green); font-size:12px; font-weight:800; text-align:center; }.membership-sponsor-flow i { color:var(--lime); font-size:22px; }.membership-ai-note { margin-top:18px; padding:28px; border:1px solid var(--line); background:var(--card); }.membership-ai-note h2 { color:var(--green); }.membership-ai-note p { color:var(--muted); }.membership-ai-note a { color:var(--green); }
  @media (max-width:1000px) { .membership-grid { grid-template-columns:1fr 1fr; } }
  @media (max-width:700px) { .membership-grid { grid-template-columns:1fr; }.membership-sponsor { grid-template-columns:1fr; }.membership-sponsor-flow { grid-template-columns:1fr; }.membership-sponsor-flow i { transform:rotate(90deg); justify-self:center; } }
</style>
