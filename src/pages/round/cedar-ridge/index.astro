---
import Layout from '../../../layouts/Layout.astro';
import { andrea, cedarRidge, holesCompleted, startingScores, sticklinkPoints, totalPar, totalStrokes } from '../../../lib/golf';
const tee = cedarRidge.teeSets[0];
const strokes = totalStrokes(startingScores);
const completed = holesCompleted(startingScores);
---
<Layout title="Live Golf Scorecard — StickLink Golf" description="Try a connected golf scorecard that keeps official strokes separate from Stableford points, tap verification, witnesses, and passport history." eyebrow="LIVE ROUND / ANDREA / CEDAR RIDGE">
  <section class="page shell"><div class="round-console-head"><div><div class="eyebrow">SCORECARD + PHYSICAL PROOF</div><h1>Round control.</h1><p class="page-lead">The official score stays clean. StickLink adds the context around it: tap verification, witness confirmation, game formats, and passport events.</p></div><div class="round-identity"><span>GOLF ID</span><b>{andrea.id.toUpperCase()}</b><small>NETWORK IDENTITY</small></div></div>
    <div class="round-summary"><div><span>COURSE</span><b>{cedarRidge.name}</b><small>{tee.name} tees · {tee.yardage.toLocaleString()} yd · {tee.rating} / {tee.slope}</small></div><div><span>OFFICIAL</span><b id="official-score">{strokes}</b><small id="official-detail">{completed} of 18 holes · {strokes - totalPar(cedarRidge, startingScores)} to par</small></div><div><span>STICKLINK</span><b id="sticklink-score">{sticklinkPoints(cedarRidge, startingScores)}</b><small>physical + witness points</small></div><button class="button" id="submit-round" type="button">Submit round</button><a class="button" href="/passport/">Open passport ↗</a></div>
    <p id="round-sync-status" role="status" aria-live="polite">Demo scorecard · connect a verified State of Stick golfer session to save and recover this round.</p>
    <div class="score-layout"><div class="panel"><div class="score-panel-head"><h2>Hole-by-hole</h2><div class="format-tabs"><button class="format-tab active" data-format="stroke">Official</button><button class="format-tab" data-format="stableford">Stableford</button><button class="format-tab" data-format="sticklink">StickLink</button></div></div><div class="score-table"><div class="score-row score-header"><span>HOLE</span><span>PAR</span><span>STROKES</span><span>STATUS</span></div>{cedarRidge.holes.map((hole) => { const score = startingScores.find((item) => item.hole === hole.number)!; return <div class:list={["score-row", { current: hole.number === completed + 1 }]} data-hole={hole.number} data-par={hole.par}><span><b>{String(hole.number).padStart(2, '0')}</b><small>{hole.name}</small></span><span>{hole.par}</span><span class="score-stepper"><button type="button" class="score-minus" aria-label={`Decrease score for hole ${hole.number}`}>−</button><b class="hole-score">{score.strokes || '—'}</b><button type="button" class="score-plus" aria-label={`Increase score for hole ${hole.number}`}>+</button></span><span class="status-badges"><i class:list={['status', { verified: score.tapVerified }]}>{score.tapVerified ? 'TAP' : 'OPEN'}</i>{score.witnessConfirmed && <i class="status witness">WITNESS</i>}</span></div>})}</div></div><aside class="panel insight-panel"><div class="eyebrow">WHY THIS IS DIFFERENT</div><h2>One round.<br />Four records.</h2><div class="record"><span class="record-dot orange"></span><div><b>Official score</b><small>What you shot under the selected rules.</small></div></div><div class="record"><span class="record-dot green"></span><div><b>Format score</b><small>Stableford, match play, skins, or a league format.</small></div></div><div class="record"><span class="record-dot lime"></span><div><b>Physical proof</b><small>Tap, witness, operator, and sensor confidence.</small></div></div><div class="record"><span class="record-dot ink"></span><div><b>Passport story</b><small>Achievements, challenges, course history, and collectibles.</small></div></div><div class="challenge-card"><span>NEXT UNLOCK</span><b>Red Tail / Hole 07</b><small>Tap the tee marker and record your closest-to-pin attempt.</small></div></aside></div>
  </section>
  <script is:inline define:vars={{ initialScores: startingScores, courseHoles: cedarRidge.holes }}>
    const rows = [...document.querySelectorAll('[data-hole]')];
    const scores = Object.fromEntries(initialScores.map((item) => [item.hole, { ...item }]));
    const apiOrigin = 'https://golf-api.stateofstick.co';
    const roundStorageKey = 'sosgolf:cedar-ridge:round-id';
    const draftStorageKey = 'sosgolf:cedar-ridge:draft';
    const clientRoundKey = 'sosgolf:cedar-ridge:client-round-id';
    const status = (message) => { document.querySelector('#round-sync-status').textContent = message; };
    const identityAssertion = () => window.StateOfStick?.identityAssertion ?? document.querySelector('meta[name="state-of-stick-identity"]')?.getAttribute('content') ?? '';
    const identityHeaders = () => identityAssertion() ? { 'content-type': 'application/json', 'x-state-of-stick-identity-assertion': identityAssertion() } : null;
    const clientRoundId = () => { let value = localStorage.getItem(clientRoundKey); if (!value) { value = `cedar-ridge-${crypto.randomUUID()}`; localStorage.setItem(clientRoundKey, value); } return value; };
    const applyServerScores = (serverScores) => { Object.values(scores).forEach((score) => { score.strokes = 0; score.tapVerified = false; score.witnessConfirmed = false; }); serverScores.forEach((score) => { if (scores[score.hole]) Object.assign(scores[score.hole], { strokes: score.strokes, tapVerified: Boolean(score.tap_verified ?? score.tapVerified), witnessConfirmed: Boolean(score.witness_confirmed ?? score.witnessConfirmed) }); }); rows.forEach((row) => { const score = scores[row.dataset.hole]; row.querySelector('.hole-score').textContent = score.strokes || '—'; }); };
    const roundRequest = async (path, options = {}) => { const headers = identityHeaders(); if (!headers) throw new Error('IDENTITY_REQUIRED'); const response = await fetch(`${apiOrigin}${path}`, { ...options, headers: { ...headers, ...(options.headers || {}) } }); const body = await response.json().catch(() => ({})); if (!response.ok) throw new Error(body.error?.message || `Request failed (${response.status})`); return body; };
    let roundId = localStorage.getItem(roundStorageKey) || '';
    let saveTimer;
    let pendingEventId = '';
    const saveScores = async () => { if (!roundId) return false; const current = Object.values(scores).filter((score) => score.strokes > 0).map((score) => ({ hole: score.hole, strokes: score.strokes, tapVerified: Boolean(score.tapVerified), witnessConfirmed: Boolean(score.witnessConfirmed) })); if (!current.length) return false; pendingEventId ||= crypto.randomUUID(); localStorage.setItem(draftStorageKey, JSON.stringify(current)); status('Saving your official strokes…'); try { const body = await roundRequest(`/api/v1/rounds/${roundId}/scores`, { method: 'POST', body: JSON.stringify({ scores: current, clientEventId: pendingEventId }) }); pendingEventId = ''; localStorage.removeItem(draftStorageKey); status(`Saved securely · ${body.round.scores.length} hole${body.round.scores.length === 1 ? '' : 's'} recorded`); return true; } catch (error) { status(error.message === 'IDENTITY_REQUIRED' ? 'Connect a verified golfer session to save this round.' : `Offline draft saved · ${error.message}`); return false; } };
    const queueSave = () => { localStorage.setItem(draftStorageKey, JSON.stringify(Object.values(scores).filter((score) => score.strokes > 0))); clearTimeout(saveTimer); saveTimer = setTimeout(saveScores, 350); };
    const recoverRound = async () => { if (!identityHeaders()) return; status('Connecting to your verified golfer session…'); try { if (!roundId) { const started = await roundRequest('/api/v1/rounds/start', { method: 'POST', body: JSON.stringify({ courseId: 'cedar-ridge', format: 'stroke_play', clientRoundId: clientRoundId() }) }); roundId = started.round.id; localStorage.setItem(roundStorageKey, roundId); } const body = await roundRequest(`/api/v1/rounds/${roundId}`); applyServerScores(body.round.scores || []); const draft = JSON.parse(localStorage.getItem(draftStorageKey) || '[]'); if (draft.length) { draft.forEach((score) => { if (scores[score.hole]) Object.assign(scores[score.hole], score); }); await saveScores(); } status(`Round recovered · ${body.round.scores?.length || 0} hole${body.round.scores?.length === 1 ? '' : 's'} saved`); refresh(); } catch (error) { status(error.message === 'IDENTITY_REQUIRED' ? 'Connect a verified golfer session to save this round.' : `Round recovery unavailable · ${error.message}`); } };
    const holeFor = (hole) => courseHoles.find((item) => item.number === Number(hole));
    const stableford = () => Object.values(scores).reduce((total, score) => { if (!score.strokes) return total; const delta = score.strokes - holeFor(score.hole).par; return total + (delta <= -3 ? 5 : delta === -2 ? 4 : delta === -1 ? 3 : delta === 0 ? 2 : delta === 1 ? 1 : 0); }, 0);
    const sticklink = () => Object.values(scores).reduce((total, score) => { if (!score.strokes) return total; const hole = holeFor(score.hole); return total + (score.tapVerified ? 1 : 0) + (score.witnessConfirmed ? 1 : 0) + (hole.challenge ? 1 : 0); }, 0);
    const refresh = (format = 'stroke') => {
      const active = Object.values(scores).filter((score) => score.strokes > 0);
      const strokes = active.reduce((sum, score) => sum + score.strokes, 0);
      const par = active.reduce((sum, score) => sum + holeFor(score.hole).par, 0);
      const value = format === 'stableford' ? stableford() : format === 'sticklink' ? sticklink() : strokes;
      document.querySelector('#official-score').textContent = String(value);
      document.querySelector('#official-detail').textContent = format === 'stableford' ? `${active.length} holes · format points` : format === 'sticklink' ? `${active.length} holes · verified context` : `${active.length} of 18 holes · ${strokes - par} to par`;
      document.querySelector('#sticklink-score').textContent = String(sticklink());
      rows.forEach((row) => { row.classList.toggle('current', Number(row.dataset.hole) === active.length + 1); });
    };
    rows.forEach((row) => { row.querySelector('.score-minus').addEventListener('click', () => { const hole = row.dataset.hole; scores[hole].strokes = Math.max(0, scores[hole].strokes - 1); row.querySelector('.hole-score').textContent = scores[hole].strokes || '—'; refresh(document.querySelector('.format-tab.active').dataset.format); queueSave(); }); row.querySelector('.score-plus').addEventListener('click', () => { const hole = row.dataset.hole; scores[hole].strokes = Math.min(12, scores[hole].strokes + 1); row.querySelector('.hole-score').textContent = scores[hole].strokes; refresh(document.querySelector('.format-tab.active').dataset.format); queueSave(); }); });
    document.querySelectorAll('.format-tab').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('.format-tab').forEach((item) => item.classList.remove('active')); button.classList.add('active'); refresh(button.dataset.format); }));
    document.querySelector('#submit-round').addEventListener('click', async () => { const saved = await saveScores(); if (!saved || Object.values(scores).filter((score) => score.strokes > 0).length !== 18) { status('Record all 18 holes before submitting this round.'); return; } try { const body = await roundRequest(`/api/v1/rounds/${roundId}/submit`, { method: 'POST', body: JSON.stringify({ clientEventId: crypto.randomUUID() }) }); document.querySelector('#submit-round').disabled = true; status(`Round submitted · ${body.round.id}`); } catch (error) { status(error.message === 'IDENTITY_REQUIRED' ? 'Connect a verified golfer session to submit this round.' : `Round submission unavailable · ${error.message}`); } });
    recoverRound();
  </script>
</Layout>
