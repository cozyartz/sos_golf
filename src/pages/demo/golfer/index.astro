---
import Layout from '../../../layouts/Layout.astro';
---
<style is:global>
  .golfer-demo { --g-ink:#142019; --g-green:#1d4935; --g-lime:#c9e56b; --g-copper:#d78355; --g-paper:#f4f1e8; --g-muted:#6b756e; background:var(--g-paper); color:#172019; min-height:100vh; }.golfer-shell { width:min(1120px,calc(100% - 44px)); margin:0 auto; }
  .golfer-top { padding:26px 0; background:var(--g-ink); color:#f7f5eb; }.golfer-topbar { display:flex; justify-content:space-between; align-items:center; gap:20px; }.golfer-topbar strong { font-size:16px; }.golfer-topbar span { color:var(--g-lime); font:10px 'DM Mono',monospace; letter-spacing:.12em; }
  .golfer-hero { padding:64px 0 38px; }.golfer-hero h1 { max-width:750px; margin:12px 0 16px; font-size:clamp(48px,7vw,82px); line-height:.94; letter-spacing:-.08em; }.golfer-hero h1 em { color:var(--g-copper); font-style:normal; }.golfer-hero p { max-width:650px; color:#53605a; font-size:18px; line-height:1.55; }.golfer-kicker { color:var(--g-copper); font:10px 'DM Mono',monospace; letter-spacing:.14em; }
  .golfer-disclaimer { margin-top:20px; padding:13px 15px; border-left:3px solid var(--g-copper); background:#e8e4d9; color:#53605a; font-size:12px; line-height:1.5; }
  .journey { display:grid; grid-template-columns:190px 1fr; gap:26px; align-items:start; padding-bottom:74px; }.journey-steps { position:sticky; top:20px; display:grid; gap:7px; }.journey-step { padding:14px; border:1px solid #d4d1c7; background:#fffdf7; color:var(--g-muted); text-align:left; font:10px 'DM Mono',monospace; cursor:pointer; }.journey-step strong { display:block; margin-bottom:5px; color:var(--g-green); font-size:14px; }.journey-step.active { border-color:var(--g-green); background:var(--g-green); color:#dbe8d8; }.journey-step.active strong { color:var(--g-lime); }.journey-stage { min-height:570px; padding:28px; border:1px solid #c9c6bb; background:#fffdf7; box-shadow:0 18px 45px #17201912; }.stage-head { display:flex; justify-content:space-between; gap:20px; align-items:start; padding-bottom:20px; border-bottom:1px solid #dfdcd3; }.stage-head h2 { margin:8px 0 4px; color:var(--g-green); font-size:30px; letter-spacing:-.06em; }.stage-head p { margin:0; color:var(--g-muted); font-size:12px; }.stage-state { color:var(--g-copper); font:10px 'DM Mono',monospace; text-transform:uppercase; }
  .stage-content { padding-top:28px; }.stage-content[hidden] { display:none; }.tap-object { display:grid; place-items:center; width:190px; height:190px; margin:8px auto 25px; border:12px solid #d4d7c4; border-radius:50%; background:radial-gradient(circle,#d78355 0 10%,#a85a37 11% 15%,#203f2e 16% 100%); color:#f7f5eb; text-align:center; box-shadow:0 10px 0 #bbb9ad,0 16px 30px #17201920; cursor:pointer; }.tap-object strong { display:block; font-size:26px; letter-spacing:-.06em; }.tap-object span { display:block; margin-top:6px; font:10px 'DM Mono',monospace; letter-spacing:.12em; }.tap-prompt { text-align:center; color:var(--g-muted); font-size:13px; }
  .hole-card { display:grid; grid-template-columns:1fr auto; gap:20px; align-items:center; padding:22px; background:#edf0df; }.hole-card h3 { margin:8px 0; color:var(--g-green); font-size:30px; letter-spacing:-.06em; }.hole-card p { margin:0; color:var(--g-muted); font-size:13px; line-height:1.5; }.hole-badge { display:grid; place-items:center; width:95px; height:95px; border-radius:50%; background:var(--g-green); color:var(--g-lime); text-align:center; font:10px 'DM Mono',monospace; }.hole-badge strong { display:block; font-size:27px; }
  .score-choice { display:flex; flex-wrap:wrap; gap:8px; margin-top:22px; }.score-choice button,.order-item button,.agent-question { padding:12px 15px; border:1px solid #c9c6bb; background:#fffdf7; color:var(--g-green); font:700 11px 'DM Mono',monospace; cursor:pointer; }.score-choice button.selected,.order-item button.selected,.agent-question:hover { border-color:var(--g-green); background:var(--g-green); color:#f7f5eb; }.stage-actions { display:flex; flex-wrap:wrap; gap:9px; margin-top:24px; }.journey-button { padding:13px 16px; border:1px solid var(--g-green); background:var(--g-green); color:#f7f5eb; font:700 11px 'DM Mono',monospace; cursor:pointer; }.journey-button.secondary { background:transparent; color:var(--g-green); }.journey-message { min-height:20px; margin-top:14px; color:var(--g-copper); font:11px 'DM Mono',monospace; }
  .order-list { display:grid; gap:9px; margin-top:18px; }.order-item { display:grid; grid-template-columns:1fr auto; gap:15px; align-items:center; padding:14px; border:1px solid #dfdcd3; }.order-item strong,.order-item small { display:block; }.order-item small { margin-top:4px; color:var(--g-muted); font-size:11px; }.order-item button { min-width:80px; }.order-total { display:flex; justify-content:space-between; margin-top:18px; padding-top:16px; border-top:1px solid #dfdcd3; color:var(--g-green); font-weight:700; }
  .agent-answer { margin-top:18px; padding:19px; border-left:3px solid var(--g-lime); background:#edf0df; color:#435148; font-size:14px; line-height:1.55; }.agent-answer strong { display:block; margin-bottom:8px; color:var(--g-green); }.agent-source { margin-top:13px; color:var(--g-muted); font:10px 'DM Mono',monospace; }.agent-question-list { display:flex; flex-wrap:wrap; gap:8px; margin-top:18px; }
  .journey-note { margin-top:18px; padding:15px; background:#f0eee7; color:var(--g-muted); font:10px 'DM Mono',monospace; line-height:1.5; }.journey-note strong { color:var(--g-green); }
  @media (max-width:760px) { .golfer-shell { width:min(100% - 36px,1120px); }.journey { grid-template-columns:1fr; }.journey-steps { position:static; grid-template-columns:repeat(4,1fr); }.journey-step { min-height:78px; padding:10px; }.journey-stage { padding:20px; }.stage-head { display:block; }.stage-state { display:block; margin-top:12px; }.hole-card { grid-template-columns:1fr; }.hole-badge { width:75px; height:75px; }.golfer-topbar span { display:none; } }
  @media (max-width:480px) { .journey-steps { grid-template-columns:1fr 1fr; }.journey-step { min-height:0; }.tap-object { width:160px; height:160px; } }
</style>
<Layout title="Golfer Journey Demo — StickLink Golf" description="Experience the proposed tap, score, service, and Golf Agent journey in the State of Stick Golf demonstration." eyebrow="STATE OF STICK GOLF / GOLFER DEMO">
  <div class="golfer-demo"><header class="golfer-top"><div class="golfer-shell golfer-topbar"><strong>STATE OF STICK / GOLF</strong><span>CONNECTED COURSE · SIMULATED GOLFER VIEW</span></div></header><main class="golfer-shell"><section class="golfer-hero"><div class="golfer-kicker">EXPERIENCE THE OTHER SIDE</div><h1>A better round begins<br />with a <em>tap.</em></h1><p>Walk through the proposed golfer experience: arrive, tap into the course, record a score, order at the turn, and ask the Golf Agent a question grounded in approved course context.</p><div class="golfer-disclaimer"><strong>DEMO ONLY</strong> Cedar Ridge and the activity shown are simulated product data. This page does not represent a live course relationship, live menu, live order, or live course condition.</div></section><section class="journey"><nav class="journey-steps" aria-label="Demo journey steps"><button class="journey-step active" data-step="arrival"><strong>01 · ARRIVE</strong>Tap in</button><button class="journey-step" data-step="score"><strong>02 · PLAY</strong>Record score</button><button class="journey-step" data-step="order"><strong>03 · REQUEST</strong>Order at turn</button><button class="journey-step" data-step="agent"><strong>04 · ASK</strong>Golf Agent</button></nav><section class="journey-stage" aria-live="polite"><div class="stage-head"><div><div class="golfer-kicker">CEDAR RIDGE / DEMO ROUND</div><h2 id="stage-title">Welcome to the course.</h2><p id="stage-subtitle">One tap opens the right moment without a complicated menu.</p></div><span class="stage-state" id="stage-state">Ready to tap</span></div><div class="stage-content" data-content="arrival"><button class="tap-object" id="tap-object" type="button"><span><strong>TAP</strong>HOLE 01<br />PAR 4</span></button><p class="tap-prompt">Tap the course marker to begin the simulated round.</p><div class="stage-actions"><button class="journey-button" id="tap-continue" type="button">Tap into the round ↗</button></div><div class="journey-note"><strong>WHAT THE COURSE CAN CONTROL</strong><br />Published hole facts, approved local guidance, event information, and available services.</div></div><div class="stage-content" data-content="score" hidden><div class="hole-card"><div><div class="golfer-kicker">HOLE 07 · TURN HOUSE</div><h3>Red Tail</h3><p>Par 3 · 148 yards · Challenge: closest-to-pin<br />Approved hole context shown for this demonstration.</p></div><div class="hole-badge"><strong>07</strong>PAR 3</div></div><p class="golfer-kicker" style="margin-top:24px">RECORD YOUR SCORE</p><div class="score-choice" role="group" aria-label="Choose a score"><button type="button" data-score="3">3</button><button type="button" data-score="4">4</button><button type="button" data-score="5">5</button><button type="button" data-score="6">6</button></div><div class="journey-message" id="score-message"></div><div class="stage-actions"><button class="journey-button" id="score-continue" type="button">Continue to turn house ↗</button></div></div><div class="stage-content" data-content="order" hidden><div class="golfer-kicker">TURN HOUSE / DEMO MENU</div><h3 style="margin:10px 0 4px;color:var(--g-green);font-size:31px;letter-spacing:-.06em">Order without leaving the round.</h3><p style="margin:0;color:var(--g-muted);font-size:13px">Select a sample item, send the request, and keep playing.</p><div class="order-list"><div class="order-item"><div><strong>Cold beverage</strong><small>Gatorade · $4 illustrative price</small></div><button type="button" data-item="Cold beverage" data-price="4">Add</button></div><div class="order-item"><div><strong>Turn-house sandwich</strong><small>Turkey club · $9 illustrative price</small></div><button type="button" data-item="Turn-house sandwich" data-price="9">Add</button></div><div class="order-item"><div><strong>Hot dog</strong><small>Course classic · $6 illustrative price</small></div><button type="button" data-item="Hot dog" data-price="6">Add</button></div></div><div class="order-total"><span>Demo request total</span><span id="order-total">$0</span></div><div class="stage-actions"><button class="journey-button" id="order-continue" type="button">Send demo request ↗</button></div><div class="journey-message" id="order-message"></div></div><div class="stage-content" data-content="agent" hidden><div class="golfer-kicker">GROUNDED COURSE ASSISTANCE</div><h3 style="margin:10px 0 4px;color:var(--g-green);font-size:31px;letter-spacing:-.06em">Ask the Golf Agent.</h3><p style="margin:0;color:var(--g-muted);font-size:13px">Choose a question to see how approved course context can produce a useful answer.</p><div class="agent-question-list"><button class="agent-question" type="button" data-question="hole">What should I know about Hole 07?</button><button class="agent-question" type="button" data-question="event">When is the next league event?</button><button class="agent-question" type="button" data-question="food">Where can I get a drink?</button></div><div class="agent-answer" id="agent-answer"><strong>Awaiting a question</strong>Select one of the examples above. The demo will show the approved context used.</div><div class="journey-note"><strong>HUMAN APPROVAL REMAINS IN CONTROL</strong><br />The Golf Agent can explain approved facts and surface options. It does not invent course information, change scores, place real orders, or take consequential action by itself.</div></div></section></section></main></div>
</Layout>
<script is:inline>
  const steps = [...document.querySelectorAll('.journey-step')];
  const contents = [...document.querySelectorAll('[data-content]')];
  const title = document.querySelector('#stage-title');
  const subtitle = document.querySelector('#stage-subtitle');
  const state = document.querySelector('#stage-state');
  const copy = { arrival:['Welcome to the course.','One tap opens the right moment without a complicated menu.','Ready to tap'], score:['Play the hole.','Keep the official score separate from the context around it.','Score in progress'], order:['Make the turn easier.','A service request can be sent to the clubhouse from the course.','Request a service'], agent:['Ask the Golf Agent.','Get a grounded answer from approved course context.','Operator-controlled guidance'] };
  const show = (name) => { steps.forEach((step) => step.classList.toggle('active', step.dataset.step === name)); contents.forEach((content) => { content.hidden = content.dataset.content !== name; }); const values = copy[name]; title.textContent = values[0]; subtitle.textContent = values[1]; state.textContent = values[2]; };
  steps.forEach((step) => step.addEventListener('click', () => show(step.dataset.step)));
  document.querySelector('#tap-object')?.addEventListener('click', () => show('score'));
  document.querySelector('#tap-continue')?.addEventListener('click', () => show('score'));
  document.querySelector('#score-continue')?.addEventListener('click', () => show('order'));
  document.querySelectorAll('[data-score]').forEach((button) => button.addEventListener('click', () => { document.querySelectorAll('[data-score]').forEach((item) => item.classList.toggle('selected', item === button)); const message = document.querySelector('#score-message'); if (message) message.textContent = `Demo score recorded: ${button.dataset.score} on Hole 07. It is not an official submitted score.`; }));
  let total = 0;
  document.querySelectorAll('[data-item]').forEach((button) => button.addEventListener('click', () => { const price = Number(button.dataset.price); total += price; button.classList.add('selected'); button.textContent = 'Added'; const totalNode = document.querySelector('#order-total'); if (totalNode) totalNode.textContent = `$${total}`; }));
  document.querySelector('#order-continue')?.addEventListener('click', () => { const message = document.querySelector('#order-message'); if (message) message.textContent = total ? `Demo request prepared for $${total}. No real order was placed.` : 'Choose an illustrative item first.'; });
  const agentAnswers = { hole:'Hole 07 is Red Tail, a par 3 at 148 yards. The approved challenge is closest-to-pin. No additional local guidance is published in this demo.', event:'The Thursday Open is the simulated league event connected to this demo course. Dates and standings would come from the published league record.', food:'The Turn House is the available simulated service point. The menu and prices shown here are illustrative and require operator approval before publication.' };
  document.querySelectorAll('[data-question]').forEach((button) => button.addEventListener('click', () => { const answer = document.querySelector('#agent-answer'); if (answer) answer.innerHTML = `<strong>Grounded answer · approved demo context</strong>${agentAnswers[button.dataset.question]}<div class="agent-source">SOURCE: DEMO COURSE RECORD · STATUS: SIMULATED · ACTION: NONE</div>`; }));
</script>
